{
  "name": "LocalMind",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "LANGSMITH_TRACING": "true",
    "LANGSMITH_PROJECT": "localmind",
    "LOCALMIND_PREFERRED_MODELS": "[\"llama3.2\",\"qwen2.5:3b\",\"llama3.2:1b\"]",
    "LOCALMIND_AGENT_MODEL": "qwen2.5:3b",
    "LOCALMIND_EVAL_JUDGE_MODEL": "qwen2.5:3b"
  },
  "secrets": {
    "LANGSMITH_API_KEY": {
      "description": "Optional. Your LangSmith API key (starts with lsv2_) to record traces, feedback and experiments. The app works without it.",
      "documentationUrl": "https://smith.langchain.com/settings"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-ollama.sh",
  "forwardPorts": [8501, 8000],
  "portsAttributes": {
    "8501": { "label": "LocalMind UI", "onAutoForward": "openBrowser" },
    "8000": { "label": "LocalMind API (/docs)", "onAutoForward": "silent" },
    "11434": { "label": "Ollama", "onAutoForward": "ignore" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    },
    "codespaces": {
      "openFiles": ["docs/CODESPACES.md"]
    }
  }
}
