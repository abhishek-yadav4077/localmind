# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Ollama ---------------------------------------------------------------
LOCALMIND_OLLAMA_BASE_URL=http://localhost:11434
LOCALMIND_DEFAULT_MODEL=llama3.2
# Models the app suggests/prefers; only the installed ones are used.
LOCALMIND_PREFERRED_MODELS=["llama3.2","mistral","qwen2.5:3b"]
LOCALMIND_AGENT_MODEL=qwen2.5:3b
LOCALMIND_EMBEDDING_MODEL=nomic-embed-text
LOCALMIND_OLLAMA_TIMEOUT_S=120
LOCALMIND_OLLAMA_MAX_RETRIES=3

# --- App ------------------------------------------------------------------
LOCALMIND_DATABASE_URL=sqlite:///data/localmind.db
LOCALMIND_LOG_LEVEL=INFO

# --- LangSmith (optional; app works without it) ---------------------------
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=localmind
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Document chat (optional: pip install -e ".[rag]") ----------------------
LOCALMIND_CHROMA_DIR=data/chroma
LOCALMIND_RAG_CHUNK_SIZE=1000
LOCALMIND_RAG_CHUNK_OVERLAP=150
LOCALMIND_RAG_TOP_K=4
